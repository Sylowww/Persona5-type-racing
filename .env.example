# Matches docker-compose.yml (local development only)
DATABASE_URL=postgresql://typing_race:typing_race@localhost:5432/typing_race

# Public base URL used to build OAuth callback URLs (defaults to the request origin)
APP_URL=http://localhost:3000

# OAuth apps. A provider's button only appears when both values are set.
# Callback URL to register: {APP_URL}/api/auth/{google|github|discord}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Maximum players per lobby (default 30, capped at 60)
LOBBY_CAPACITY=

# Extra hosts allowed to use the dev server, comma-separated (e.g. your LAN IP so friends can join)
ALLOWED_DEV_ORIGINS=
